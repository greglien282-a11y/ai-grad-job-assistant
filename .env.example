# Backend CORS allowlist; origins must be comma-separated without trailing slashes.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL persistence for M1-1A; health checks still work without a database.
POSTGRES_DB=pathwise_dev
POSTGRES_USER=pathwise_dev
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+psycopg://pathwise_dev:change-me-for-local-development@127.0.0.1:5432/pathwise_dev
# Tests create/drop a random schema in this dedicated test database, never use real data.
# TEST_DATABASE_URL=postgresql+psycopg://pathwise_dev:change-me-for-local-development@127.0.0.1:5432/pathwise_test
